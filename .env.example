# --- Static landing deploy (Vercel: set in Production + Preview) ---
# When true: no Prisma/Supabase at build or runtime; APIs return mocks. Schemas stay in repo.
DISABLE_DB=true

# --- Database ---
# DATABASE_URL=postgresql://user:password@localhost:5432/wego?schema=public

# --- Auth ---
AUTH_SECRET=supersecretvalue

# =============================================================================
# Tenant isolation (required for shared Supabase + one backend, multiple businesses)
# =============================================================================
# Primary key — must match SiteSettings.id, Package.project_key, User.project_key, storage prefix, etc.
# Example for Wego:
NEXT_PUBLIC_PROJECT_KEY=WEGO

# Legacy alias if you still use WegoBiz naming (used only when NEXT_PUBLIC_PROJECT_KEY is unset):
# NEXT_PUBLIC_WEGOBIZ_USER_ID=

# Server-only optional default (builds, scripts, CI):
# DEFAULT_PROJECT_KEY=WEGO

# Seed script tenant (npm run seed) — defaults to NEXT_PUBLIC_PROJECT_KEY chain then "demo":
# SEED_PROJECT_KEY=WEGO

# Optional: comma-separated allowlist for POST /api/webhook/payment { project_key } (empty = no extra filter)
# ALLOWED_PROJECT_KEYS=WEGO,OTHER_CLIENT

# --- WhatsApp click-to-chat (digits only, country code without +) ---
# Default: 972545467273 (054-546-7273). Override for other deployments:
NEXT_PUBLIC_WHATSAPP_PHONE=972545467273
